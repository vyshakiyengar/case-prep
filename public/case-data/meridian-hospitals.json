gular-41\"/>\n     <use xlink:href=\"#IBMPlexSans-Regular-3b\" transform=\"translate(60 0)\"/>\n    </g>\n   </g>\n   <g id=\"text_21\">\n    <!-- 70 -->\n    <g style=\"fill: #2d3748\" transform=\"translate(129.977257 27.855385) scale(0.08 -0.08)\">\n     <use xlink:href=\"#IBMPlexSans-Regular-41\"/>\n     <use xlink:href=\"#IBMPlexSans-Regular-38\" transform=\"translate(60 0)\"/>\n    </g>\n   </g>\n   <g id=\"text_22\">\n    <!-- 69 -->\n    <g style=\"fill: #2d3748\" transform=\"translate(157.490354 29.412308) scale(0.08 -0.08)\">\n     <use xlink:href=\"#IBMPlexSans-Regular-40\"/>\n     <use xlink:href=\"#IBMPlexSans-Regular-43\" transform=\"translate(60 0)\"/>\n    </g>\n   </g>\n   <g id=\"text_23\">\n    <!-- 68 -->\n    <g style=\"fill: #2d3748\" transform=\"translate(185.003451 30.969231) scale(0.08 -0.08)\">\n     <use xlink:href=\"#IBMPlexSans-Regular-40\"/>\n     <use xlink:href=\"#IBMPlexSans-Regular-42\" transform=\"translate(60 0)\"/>\n    </g>\n   </g>\n   <g id=\"text_24\">\n    <!-- 66 -->\n    <g style=\"fill: #2d3748\" transform=\"translate(212.516549 34.083077) scale(0.08 -0.08)\">\n     <use xlink:href=\"#IBMPlexSans-Regular-40\"/>\n     <use xlink:href=\"#IBMPlexSans-Regular-40\" transform=\"translate(60 0)\"/>\n    </g>\n   </g>\n   <g id=\"text_25\">\n    <!-- 64 -->\n    <g style=\"fill: #2d3748\" transform=\"translate(240.029646 37.196923) scale(0.08 -0.08)\">\n     <use xlink:href=\"#IBMPlexSans-Regular-40\"/>\n     <use xlink:href=\"#IBMPlexSans-Regular-3e\" transform=\"translate(60 0)\"/>\n    </g>\n   </g>\n   <g id=\"text_26\">\n    <!-- 60 -->\n    <g style=\"fill: #2d3748\" transform=\"translate(267.542743 43.424615) scale(0.08 -0.08)\">\n     <use xlink:href=\"#IBMPlexSans-Regular-40\"/>\n     <use xlink:href=\"#IBMPlexSans-Regular-38\" transform=\"translate(60 0)\"/>\n    </g>\n   </g>\n   <g id=\"text_27\">\n    <!-- 44 -->\n    <g style=\"fill: #2d3748\" transform=\"translate(295.05584 68.335385) scale(0.08 -0.08)\">\n     <use xlink:href=\"#IBMPlexSans-Regular-3e\"/>\n     <use xlink:href=\"#IBMPlexSans-Regular-3e\" transform=\"translate(60 0)\"/>\n    </g>\n   </g>\n   <g id=\"text_28\">\n    <!-- 41 -->\n    <g style=\"fill: #2d3748\" transform=\"translate(322.568937 73.006154) scale(0.08 -0.08)\">\n     <use xlink:href=\"#IBMPlexSans-Regular-3e\"/>\n     <use xlink:href=\"#IBMPlexSans-Regular-3b\" transform=\"translate(60 0)\"/>\n    </g>\n   </g>\n   <g id=\"text_29\">\n    <!-- 39 -->\n    <g style=\"fill: #2d3748\" transform=\"translate(350.082034 76.12) scale(0.08 -0.08)\">\n     <use xlink:href=\"#IBMPlexSans-Regular-3d\"/>\n     <use xlink:href=\"#IBMPlexSans-Regular-43\" transform=\"translate(60 0)\"/>\n    </g>\n   </g>\n  </g>\n </g>\n <defs>\n  <clipPath id=\"pd48413669d\">\n   <rect x=\"25\" y=\"11.528\" width=\"357.12\" height=\"127.512\"/>\n  </clipPath>\n </defs>\n</svg>\n","title":"Exhibit 1 · Bed occupancy by hospital, %","note":"H10-H12 opened in the last 3 years in newer parts of the cities."},"answer":"<p>Nine hospitals sit between 60% and 78%. Three newer ones (H10-H12) are around 40% and drag the average down to 62%. <b>So-what:</b> the occupancy problem is concentrated. Typical causes for new hospitals: not enough well-known doctors, and few referrals from local GPs. Fixing these three is the fastest growth lever available.</p>"},{"q":"How much revenue would Meridian gain by raising average occupancy from 62% to 75%?","exhibit":null,"answer":"<p>Inpatient revenue = 65% × $300M = $195M. Assuming revenue grows in line with occupied beds: $195M × 75/62 ≈ $236M → <b>+$41M</b>.</p> <p>If the other streams (outpatient, pharmacy, diagnostics: $105M) grow ~10% a year organically: $105M × 1.1⁵ ≈ $169M → <b>+$64M</b>.</p> <p>Existing hospitals ≈ <b>+$105M</b>. Gap still to fill ≈ <b>$195M</b>. <b>So-what:</b> around two-thirds of the target needs new capacity.</p><p>Note: a 75% <i>average</i> means every hospital at the peer benchmark. Lifting only H10-H12 to 75% takes the average to about 70% (about +$26M); the nine established hospitals (about 69%) must also rise.</p>"},{"q":"Here are two ways to add capacity. How would you fill the remaining $195M?","exhibit":{"kind":"table","headers":["Per hospital","Build new (big city)","Buy existing (tier-2 city)"],"rows":[["Cost","$40M","$37.5M (1.5× revenue)"],["Revenue at maturity","$35M","$25M today; ~$35M after upgrade"],["Time to full revenue","4 years","Immediate, upgrade over 2 years"],["Main risk","Construction delays","Quality, integration, culture"]],"title":"Exhibit 2 · Build vs buy","note":null,"align":["l","r","r"],"boldLast":false},"answer":"<p>A hospital built in year 1 only matures in year 5, so building alone is too slow: ~5-6 new hospitals ($200-240M) all opened in year 1.</p> <p><b>Buying</b> gives revenue straight away: about 4 acquisitions at ~$35M each after upgrade ≈ $140M for ~$150M. Add 2 new builds in big cities for ≈ $55-70M by year 5 → total ≈ <b>$195-210M</b>.</p> <p><b>Funding:</b> ~$230M over 5 years, plus upgrade capex for the acquired hospitals (ask the interviewer), against ~$54M+ a year of EBITDA. Doable with some debt, but tight. Look at asset-light options (management contracts) to reduce the capital needed.</p>"}],"reco":"Meridian can reach $600M, but it can't build its way there in five years. I recommend three steps: (1) lift occupancy across all 12 hospitals to the 75% peer benchmark, starting with the three under-filled ones (+~$40M; fixing only those three gives about +$26M), alongside organic growth in outpatient, pharmacy and diagnostics (+~$65M); (2) buy about four hospitals in tier-2 cities (+~$140M), which also opens new markets; (3) build two flagship hospitals in big cities (+~$60M by year 5). Total investment is about $230M. The biggest risk is keeping quality consistent across acquired hospitals, so next steps are a clinical-quality checklist for acquisitions and a shortlist of targets.","great":["Sizes each lever, adds them up, and names the remaining gap","Notices that new builds take 4 years to mature","Checks whether the plan can be funded","Mentions quality, the client's own constraint"],"id":3,"slug":"meridian-hospitals"}